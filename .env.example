# ==============================================================================
# ClipLane Environment Variables Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS. Copy to .env.local for Next.js or .env for worker.
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Deployment Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=ClipLane
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ------------------------------------------------------------------------------
# Supabase Configuration
# Note: SUPABASE_SERVICE_ROLE_KEY MUST NEVER be exposed in client code or NEXT_PUBLIC_*
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# Queue Configuration (Truthful Queue Engine)
# ------------------------------------------------------------------------------
FREE_LANE_MIN_WAIT_HOURS=24
FREE_LANE_MAX_JOBS_PER_HOUR=10
WORKER_CONCURRENCY=2
AVERAGE_JOB_DURATION_SECONDS=45
RESULT_RETENTION_DAYS=3

# ------------------------------------------------------------------------------
# Media Intake Configuration
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=209715200
MAX_VIDEO_DURATION_SECONDS=300
CLIPS_PER_JOB=3
MIN_CLIP_DURATION_SECONDS=15
MAX_CLIP_DURATION_SECONDS=30

# ------------------------------------------------------------------------------
# Pricing & Payments (USD & Crypto)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PRIORITY_JOB_PRICE_USD=2.99
PRIORITY_BUNDLE_PRICE_USD=9.99
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
CRYPTO_COMMERCE_API_KEY=placeholder
CRYPTO_WEBHOOK_SECRET=placeholder

# ------------------------------------------------------------------------------
# Rate Limiting (Upstash Redis - leave empty for in-memory fallback in dev)
# ------------------------------------------------------------------------------
UPstash_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# Admin & Compliance
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@cliplane.tech
COPYRIGHT_CONTACT_EMAIL=copyright@cliplane.tech
