{
  "name": "cliplane-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @cliplane/shared build && pnpm --filter @cliplane/worker build && pnpm --filter @cliplane/web build",
    "dev": "pnpm --parallel dev",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "clean": "pnpm --recursive run clean"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "next": "15.1.7",
    "pg-mem": "^3.0.14",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@12.18.0"
}
